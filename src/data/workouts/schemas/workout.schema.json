{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trackvault.local/schemas/workout.schema.json",
  "title": "Track.Vault Workout v1.1 Navigation Ready Schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "slug",
    "title",
    "shortTitle",
    "summary",
    "targetDistances",
    "primaryDistance",
    "category",
    "trainingGoals",
    "level",
    "phase",
    "surface",
    "equipment",
    "estimatedDurationMin",
    "estimatedDistanceKm",
    "qualityDistanceKm",
    "difficulty",
    "risk",
    "riskReason",
    "intensityGuide",
    "workoutStructure",
    "variants",
    "coachingNotes",
    "commonMistakes",
    "safetyNotes",
    "shareCard",
    "tags",
    "searchKeywords",
    "uniquenessSignature",
    "createdBy",
    "visibility",
    "sourceNote",
    "libraryCategoryId",
    "libraryCategoryLabel",
    "workoutType",
    "distanceNavId",
    "distanceNavLabel",
    "distanceSortOrder"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "shortTitle": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "targetDistances": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "primaryDistance": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "workoutType": {
      "type": "string"
    },
    "trainingGoals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "level": {
      "enum": [
        "beginner",
        "recreational",
        "developing",
        "intermediate",
        "advanced",
        "competitive",
        "elite-reference"
      ]
    },
    "phase": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "surface": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimatedDurationMin": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "estimatedDistanceKm": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "qualityDistanceKm": {
      "type": "number"
    },
    "difficulty": {
      "enum": [
        "easy",
        "moderate",
        "moderate-hard",
        "hard",
        "very-hard"
      ]
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "very-high"
      ]
    },
    "riskReason": {
      "type": "string"
    },
    "libraryCategoryId": {
      "type": "string"
    },
    "libraryCategoryLabel": {
      "type": "string"
    },
    "distanceNavId": {
      "enum": [
        "100m",
        "200m",
        "400m",
        "800m",
        "1500m",
        "mile",
        "3k",
        "5k",
        "10k",
        "half-marathon",
        "marathon",
        "trail",
        "treadmill",
        "base-recovery",
        "general"
      ]
    },
    "distanceNavLabel": {
      "type": "string"
    },
    "distanceSortOrder": {
      "type": "integer"
    },
    "intensityGuide": {
      "type": "object"
    },
    "workoutStructure": {
      "type": "object",
      "required": [
        "warmup",
        "mainSet",
        "cooldown"
      ],
      "properties": {
        "warmup": {
          "type": "array"
        },
        "mainSet": {
          "type": "array"
        },
        "cooldown": {
          "type": "array"
        }
      }
    },
    "variants": {
      "type": "object",
      "required": [
        "easier",
        "harder"
      ]
    },
    "coachingNotes": {
      "type": "array"
    },
    "commonMistakes": {
      "type": "array"
    },
    "safetyNotes": {
      "type": "array"
    },
    "shareCard": {
      "type": "object"
    },
    "tags": {
      "type": "array"
    },
    "searchKeywords": {
      "type": "array"
    },
    "uniquenessSignature": {
      "type": "string"
    },
    "createdBy": {
      "type": "string"
    },
    "visibility": {
      "type": "string"
    },
    "sourceNote": {
      "type": "string"
    }
  }
}
